# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.eggs/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Easel session state and output
*.easel
out/
output/
samples/*.png
samples/*.gif
!samples/.gitkeep
# The brush sampler is the project's primary test artefact and its best
# at-a-glance description, so it is committed even though it is generated.
!samples/brushes.png
!samples/shapes.png

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# M5 rehearsal. The two finished paintings and their time-lapses are the evidence
# the brief's definition of done asks for; the intermediate looks and probe sheets
# beside them regenerate from the scripts in the same directory.
rehearsal/*.png
rehearsal/*.gif
!rehearsal/copy_final.png
!rehearsal/own_final.png
!rehearsal/copy_timelapse.gif
!rehearsal/own_timelapse.gif

# M5, second rehearsal (a fresh session with the revised guide). Same rule: the two
# paintings, their time-lapses and the comparison sheet are evidence; the looks and
# probe sheets regenerate from the scripts beside them.
rehearsal2/**/*.png
rehearsal2/*.gif
!rehearsal2/copy_final.png
!rehearsal2/own_final.png
!rehearsal2/copies_compared.png
!rehearsal2/copy_timelapse.gif
!rehearsal2/own_timelapse.gif

# Golden images: the stored ones are committed (they are what a human looks at
# when a case fails). The `.actual.png` a failing test writes beside them is not.
tests/golden/*.actual.png
# M8's evidence: the pair of paintings, not the looks and time-lapses beside them.
m8/*.png
m8/*.gif
!m8/boxes.png
!m8/shapes.png

# M6 final pass (rehearsal3): three fresh sessions — the headline copy plus its
# unprompted painting, the sitter, and the assisted run. Same rule as before: the
# finished paintings, their time-lapses and the comparison sheets are evidence; the
# intermediate looks and probe sheets regenerate from the scripts beside them.
rehearsal3/**/*.png
rehearsal3/**/*.gif
!rehearsal3/**/copy_final.png
!rehearsal3/**/own_final.png
!rehearsal3/**/copy_timelapse.gif
!rehearsal3/**/own_timelapse.gif
!rehearsal3/*.png

# M8b's evidence: the pair of paintings and the sheet, not the looks beside them.
m8b/*.png
m8b/*.gif
!m8b/before.png
!m8b/after.png
!m8b/compared.png
